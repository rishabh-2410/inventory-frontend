{
  "expo": {
    "name": "Invento Pro",
    "slug": "invento-pro",
    "scheme": "invento-pro",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/invento.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "@react-native-vector-icons/material-icons",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/invento.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rishabh.inventopro",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/invento.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b22eb308-ecf7-46e9-b814-8c6b0074827b"
      }
    }
  }
}
